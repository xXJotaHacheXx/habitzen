{
  "expo": {
    "name": "HabitZen",
    "slug": "habitzen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#14968C",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "HabitZen – Gestor de hábitos y bienestar",
      "shortName": "HabitZen",
      "themeColor": "#14968C",
      "backgroundColor": "#FFFFFF",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#14968C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HabitZen usa tu ubicación para sugerirte actividades al aire libre según el clima."
        }
      ],
      "expo-font"
    ],
    "scheme": "habitzen"
  }
}
